[Unit]
Description=Super-agent GitHub service
Requires=docker.service
After=docker.service

[Service]
Type=simple
WorkingDirectory=%h/superagent
EnvironmentFile=%h/.config/superagent/service.env
ExecStart=/usr/bin/java -jar %h/superagent/superagent-java.jar --serve --repo %h/superagent/source
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
