# Copy to ~/.config/superagent/service.env and protect it with chmod 600.
# Use an absolute path for the persistent state directory.
SUPERAGENT_STATE_DIR=/home/superagent/superagent/state
SUPERAGENT_PORT=8080
SUPERAGENT_BASE_URL=https://api.deepseek.com
SUPERAGENT_MODEL=deepseek-flash
SUPERAGENT_PROVIDER=deepseek
SUPERAGENT_API_KEY=
SUPERAGENT_GITHUB_REPO=organization/repository
SUPERAGENT_GITHUB_REPO_ID=
SUPERAGENT_GITHUB_BASE=main
SUPERAGENT_GITHUB_ACTOR_IDS=
SUPERAGENT_GITHUB_WEBHOOK_SECRET=
SUPERAGENT_OPERATOR_TOKEN=
SUPERAGENT_GITHUB_TOKEN=
SUPERAGENT_SANDBOX_IMAGE=
SUPERAGENT_WORKERS=2
SUPERAGENT_MAX_MODEL_CALLS=30
SUPERAGENT_MAX_TOKENS=100000
SUPERAGENT_COMMAND_TIMEOUT_SECONDS=120
# Optional HTTP timeout for model calls (default 120 seconds).
SUPERAGENT_HTTP_TIMEOUT_SECONDS=120

# --- 容器化部署（docker-compose.yml）----------------------------------------
# 容器内状态目录固定为 /app/state（命名卷挂载点），compose 会用同一变量覆盖此处的
# 宿主机路径；本文件仍保留 SUPERAGENT_STATE_DIR 供 systemd 部署使用。
# 目标仓库目录由 compose 挂载为 ./source:/app/source:ro，属主须为容器内 uid 10001。

# --- 备份（deploy/backup.sh）-----------------------------------------------
# 这些变量只由宿主机的备份脚本读取，服务本身不读取，放在同一文件便于运维。
# Backups live next to the state directory by default.
SUPERAGENT_BACKUP_DIR=
# Number of backup archives to keep; backup.sh deletes the oldest beyond this.
SUPERAGENT_BACKUP_KEEP=7
# systemd unit name and scope (user|system|none) for stop/restart during backup.
SUPERAGENT_SERVICE=superagent.service
SUPERAGENT_SERVICE_SCOPE=user
