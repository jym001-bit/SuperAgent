{
  "id": "username-validation",
  "name": "增加参数校验：用户名校验规则",
  "prompt": "按 docs/username-case.md 的需求完善 UsernameValidator.isValid：用户名为 null 返回 false；只允许 ASCII 字母、数字和下划线；长度 3 到 16（含边界）；空格、标点和非 ASCII 字符都不通过。只改 src/main/java/demo/UsernameValidator.java，不要修改 verify/UsernameProbe.java。",
  "setup": {
    "files": {
      "src/main/java/demo/UsernameValidator.java": [
        "package demo;",
        "",
        "public final class UsernameValidator {",
        "    private UsernameValidator() {}",
        "",
        "    public static boolean isValid(String username) {",
        "        return username != null && !username.isBlank();",
        "    }",
        "}",
        ""
      ],
      "verify/UsernameProbe.java": [
        "package verify;",
        "",
        "import demo.UsernameValidator;",
        "",
        "public final class UsernameProbe {",
        "    private UsernameProbe() {}",
        "",
        "    public static void main(String[] args) {",
        "        expect(false, null);",
        "        expect(true, \"abc\");",
        "        expect(true, \"a_b1\");",
        "        expect(true, \"abcdefghijklmnop\");",
        "        expect(false, \"ab\");",
        "        expect(false, \"abcdefghijklmnopq\");",
        "        expect(false, \"ab c\");",
        "        expect(false, \"abc-\");",
        "        expect(false, \"用户名abc\");",
        "        System.out.println(\"USERNAME_PROBE_OK\");",
        "    }",
        "",
        "    private static void expect(boolean expected, String value) {",
        "        boolean actual = UsernameValidator.isValid(value);",
        "        if (actual != expected)",
        "            throw new AssertionError(String.valueOf(value) + \" => \" + actual + \", expected \" + expected);",
        "    }",
        "}",
        ""
      ]
    }
  },
  "checks": [
    { "op": "command", "command": "javac -d out src/main/java/demo/UsernameValidator.java verify/UsernameProbe.java", "exitCode": 0, "timeoutSeconds": 120 },
    { "op": "command", "command": "java -cp out verify.UsernameProbe", "exitCode": 0, "outputContains": "USERNAME_PROBE_OK", "timeoutSeconds": 120 },
    { "op": "file_equals", "path": "verify/UsernameProbe.java", "contentLines": [
      "package verify;",
      "",
      "import demo.UsernameValidator;",
      "",
      "public final class UsernameProbe {",
      "    private UsernameProbe() {}",
      "",
      "    public static void main(String[] args) {",
      "        expect(false, null);",
      "        expect(true, \"abc\");",
      "        expect(true, \"a_b1\");",
      "        expect(true, \"abcdefghijklmnop\");",
      "        expect(false, \"ab\");",
      "        expect(false, \"abcdefghijklmnopq\");",
      "        expect(false, \"ab c\");",
      "        expect(false, \"abc-\");",
      "        expect(false, \"用户名abc\");",
      "        System.out.println(\"USERNAME_PROBE_OK\");",
      "    }",
      "",
      "    private static void expect(boolean expected, String value) {",
      "        boolean actual = UsernameValidator.isValid(value);",
      "        if (actual != expected)",
      "            throw new AssertionError(String.valueOf(value) + \" => \" + actual + \", expected \" + expected);",
      "    }",
      "}",
      ""
    ] }
  ],
  "script": [
    { "tool": "read_file", "arguments": { "path": "src/main/java/demo/UsernameValidator.java" } },
    { "tool": "write_file", "arguments": { "path": "src/main/java/demo/UsernameValidator.java", "contentLines": [
      "package demo;",
      "",
      "public final class UsernameValidator {",
      "    private UsernameValidator() {}",
      "",
      "    public static boolean isValid(String username) {",
      "        if (username == null) return false;",
      "        if (username.length() < 3 || username.length() > 16) return false;",
      "        for (int i = 0; i < username.length(); i++) {",
      "            char c = username.charAt(i);",
      "            boolean allowed = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')",
      "                    || (c >= '0' && c <= '9') || c == '_';",
      "            if (!allowed) return false;",
      "        }",
      "        return true;",
      "    }",
      "}",
      ""
    ] } },
    { "answer": "已按规则重写 UsernameValidator.isValid：null、长度 3 到 16、ASCII 字母数字下划线校验，并说明边界包含 3 和 16。" }
  ]
}
