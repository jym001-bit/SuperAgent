# The local .env supports DEEPSEEK_API_KEY for the official DeepSeek API.
# Set the other values in your shell environment to override the defaults.
DEEPSEEK_API_KEY=
SUPERAGENT_BASE_URL=https://api.deepseek.com
SUPERAGENT_MODEL=deepseek-flash
SUPERAGENT_API_KEY=
# deepseek or standard (standard omits DeepSeek-specific request fields)
SUPERAGENT_PROVIDER=deepseek
SUPERAGENT_THINKING=true
# SUPERAGENT_STATE_DIR=D:/superagent-state
SUPERAGENT_WORKERS=2
SUPERAGENT_MAX_MODEL_CALLS=30
SUPERAGENT_MAX_TOKENS=100000
SUPERAGENT_COMMAND_TIMEOUT_SECONDS=120
SUPERAGENT_HTTP_TIMEOUT_SECONDS=120
# Local HTTP service only. Choose an independent random token with at least 32 characters.
SUPERAGENT_PORT=8080
SUPERAGENT_OPERATOR_TOKEN=
